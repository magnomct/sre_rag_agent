# =============================================================
# .env.example — SRE RAG Agent
# Template de variáveis de ambiente. Copie para .env e preencha
# com os valores reais. NUNCA commite o arquivo .env.
# =============================================================

# ── Application ───────────────────────────────────────────────
APP_NAME=sre-rag-api
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Server ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
WORKERS=2

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
POSTGRES_DB=sre_rag
POSTGRES_USER=sre_user
POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── RAG / Embeddings ──────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K=5

# ── Alertmanager / Webhooks ───────────────────────────────────
# Configure via GitHub Secrets em produção.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME
PAGERDUTY_SERVICE_KEY=CHANGE_ME
